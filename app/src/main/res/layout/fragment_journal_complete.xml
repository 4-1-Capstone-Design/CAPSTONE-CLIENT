<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingTop="60dp">

    <ImageView
        android:id="@+id/logo"
        android:layout_width="120dp"
        android:layout_height="45dp"
        android:src="@drawable/monini_logo"
        android:scaleType="fitXY"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <View
        android:layout_width="223dp"
        android:layout_height="217dp"
        android:background="@drawable/circle_small"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="-90dp"
        android:layout_marginTop="95dp"/>

    <View
        android:layout_width="92dp"
        android:layout_height="86dp"
        android:background="@drawable/circle_small"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="282dp"
        android:layout_marginEnd="-20dp"/>

    <View
        android:layout_width="443dp"
        android:layout_height="457dp"
        android:background="@drawable/circle_large"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="138dp"
        android:layout_marginBottom="-200dp"/>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="오늘의"
            android:fontFamily="@font/gowun_batang"
            android:textSize="18sp"
            android:textColor="#3D3D3D"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="모닝저널 작성이"
            android:fontFamily="@font/gowun_batang"
            android:textSize="18sp"
            android:textColor="#3D3D3D"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="완료되었습니다."
            android:fontFamily="@font/gowun_batang"
            android:textSize="18sp"
            android:textColor="#3D3D3D"
            android:layout_marginBottom="40dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="From Monini"
            android:fontFamily="@font/gowun_batang"
            android:textStyle="italic"
            android:textSize="18sp"
            android:textColor="#3D3D3D"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>