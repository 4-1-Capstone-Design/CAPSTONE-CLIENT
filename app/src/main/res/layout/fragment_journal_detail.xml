<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingLeft="25dp"
        android:paddingRight="25dp"
        android:paddingTop="60dp"
        android:paddingBottom="20dp">

        <ImageView
            android:id="@+id/logo"
            android:layout_width="120dp"
            android:layout_height="45dp"
            android:src="@drawable/monini_logo"
            android:scaleType="fitXY"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <TextView
            android:id="@+id/tv_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2026-04-30"
            android:fontFamily="@font/gowun_batang"
            android:textSize="14sp"
            android:textColor="#3D3D3D"
            android:background="@drawable/et_border"
            android:paddingLeft="24dp"
            android:paddingRight="24dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:layout_marginTop="20dp"
            app:layout_constraintTop_toBottomOf="@id/logo"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="모닝저널 제목"
            android:fontFamily="@font/gowun_batang"
            android:textSize="14sp"
            android:textColor="#3D3D3D"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/tv_date"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <TextView
            android:id="@+id/q1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1. 지금 어떤 기분이신가요 ? 왜 그런 기분이신가요?"
            android:fontFamily="@font/gowun_batang"
            android:textSize="13sp"
            android:textColor="#3D3D3D"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/tv_title"
            app:layout_constraintStart_toStartOf="parent"/>

        <EditText
            android:id="@+id/et_q1"
            android:layout_width="match_parent"
            android:layout_height="86dp"
            android:fontFamily="@font/gowun_batang"
            android:textSize="13sp"
            android:textColor="#3D3D3D"
            android:background="@drawable/et_journal_border"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:paddingTop="12dp"
            android:gravity="top"
            android:focusable="false"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/q1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <TextView
            android:id="@+id/q2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="2. 꼭 이루고싶은 것은 무엇인가요?"
            android:fontFamily="@font/gowun_batang"
            android:textSize="13sp"
            android:textColor="#3D3D3D"
            android:layout_marginTop="20dp"
            app:layout_constraintTop_toBottomOf="@id/et_q1"
            app:layout_constraintStart_toStartOf="parent"/>

        <EditText
            android:id="@+id/et_q2"
            android:layout_width="match_parent"
            android:layout_height="86dp"
            android:fontFamily="@font/gowun_batang"
            android:textSize="13sp"
            android:textColor="#3D3D3D"
            android:background="@drawable/et_journal_border"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:paddingTop="12dp"
            android:gravity="top"
            android:focusable="false"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/q2"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <TextView
            android:id="@+id/q3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="3. 오늘 하루는 어떨 것 같나요?"
            android:fontFamily="@font/gowun_batang"
            android:textSize="13sp"
            android:textColor="#3D3D3D"
            android:layout_marginTop="20dp"
            app:layout_constraintTop_toBottomOf="@id/et_q2"
            app:layout_constraintStart_toStartOf="parent"/>

        <EditText
            android:id="@+id/et_q3"
            android:layout_width="match_parent"
            android:layout_height="86dp"
            android:fontFamily="@font/gowun_batang"
            android:textSize="13sp"
            android:textColor="#3D3D3D"
            android:background="@drawable/et_journal_border"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:paddingTop="12dp"
            android:gravity="top"
            android:focusable="false"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/q3"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <TextView
            android:id="@+id/q4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="4. 어떤 사람이 좋은 사람이라고 생각하시나요?"
            android:fontFamily="@font/gowun_batang"
            android:textSize="13sp"
            android:textColor="#3D3D3D"
            android:layout_marginTop="20dp"
            app:layout_constraintTop_toBottomOf="@id/et_q3"
            app:layout_constraintStart_toStartOf="parent"/>

        <EditText
            android:id="@+id/et_q4"
            android:layout_width="match_parent"
            android:layout_height="86dp"
            android:fontFamily="@font/gowun_batang"
            android:textSize="13sp"
            android:textColor="#3D3D3D"
            android:background="@drawable/et_journal_border"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:paddingTop="12dp"
            android:gravity="top"
            android:focusable="false"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/q4"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <TextView
            android:id="@+id/btn_check_reply"
            android:layout_width="100dp"
            android:layout_height="37dp"
            android:text="답장 확인"
            android:fontFamily="@font/gowun_batang"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:background="@drawable/btn_login"
            android:gravity="center"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="20dp"
            app:layout_constraintTop_toBottomOf="@id/et_q4"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>