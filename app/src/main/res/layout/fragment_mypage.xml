<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingLeft="40dp"
    android:paddingRight="40dp"
    android:paddingTop="60dp"
    android:paddingBottom="20dp">

    <ImageView
        android:id="@+id/logo"
        android:layout_width="120dp"
        android:layout_height="45dp"
        android:src="@drawable/monini_logo"
        android:scaleType="fitXY"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <LinearLayout
        android:id="@+id/content_area"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/logo"
        app:layout_constraintBottom_toTopOf="@id/btn_logout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <EditText
            android:id="@+id/et_email"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:hint="E-mail"
            android:text="E-mail : 123@test.com"
            android:fontFamily="@font/michroma_regular"
            android:textSize="13sp"
            android:textColor="#5D5D5D"
            android:background="@drawable/et_border"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:focusable="false"
            android:layout_marginBottom="12dp"/>

        <EditText
            android:id="@+id/et_nickname"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:text="Nickname : 모닝이"
            android:fontFamily="@font/michroma_regular"
            android:textSize="13sp"
            android:textColor="#5D5D5D"
            android:background="@drawable/et_border"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:focusable="false"
            android:layout_marginBottom="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="40dp">

            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/heart"
                android:layout_marginRight="4dp"/>

            <TextView
                android:id="@+id/tv_withdraw"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="회원탈퇴"
                android:fontFamily="@font/michroma_regular"
                android:textSize="12sp"
                android:textColor="#5D5D5D"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <ImageView
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:src="@drawable/clover"
                android:scaleType="fitXY"
                android:layout_marginRight="16dp"/>

            <TextView
                android:id="@+id/tv_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="15개"
                android:fontFamily="@font/gowun_batang"
                android:textSize="20sp"
                android:textColor="#3D3D3D"/>
        </LinearLayout>

        <TextView
            android:id="@+id/tv_clover_comment"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/gowun_batang"
            android:textSize="15sp"
            android:textColor="#3D3D3D"/>

    </LinearLayout>

    <TextView
        android:id="@+id/btn_logout"
        android:layout_width="100dp"
        android:layout_height="37dp"
        android:text="Logout"
        android:fontFamily="@font/michroma_regular"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:background="@drawable/btn_login"
        android:gravity="center"
        android:layout_marginBottom="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>